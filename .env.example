# ═══════════════════════════════════════════
# InterviewAce — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── AI BACKEND ────────────────────────────
# InterviewAce now supports OpenAI and Anthropic for both prep and live answers.
# The dashboard model selector determines which provider/model powers that session.
PREP_MODEL=gpt-5-mini

# The selected dashboard model powers both prep and live answers for that session.
DEFAULT_MODEL=gpt-5-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_REASONING_EFFORT=minimal
OPENAI_TEXT_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=220
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_OUTPUT_TOKENS=220

# ─── AUDIO DEVICES ─────────────────────────
# Run this to list your devices:
#   python -c "import sounddevice; print(sounddevice.query_devices())"
#
# Mac: Install BlackHole first (brew install blackhole-2ch)
# Windows: Install VB-Audio Cable first (https://vb-audio.com/Cable/)

SYSTEM_AUDIO_DEVICE=BlackHole 2ch
MIC_DEVICE=MacBook Pro Microphone

# ─── OPTIONAL (have sensible defaults) ─────
# Whisper model for transcription (runs locally)
# Options: tiny.en (fastest) | base.en (recommended) | small.en (most accurate)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Audio tuning
SILENCE_THRESHOLD=0.01
SILENCE_DURATION=0.8

# Conversation history limit (number of messages to keep)
MAX_CONVERSATION_HISTORY=40
